<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Grid / Sandbox — Puzzle Editor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0d1826;
    --paper:#15253a;
    --paper2:#1b2f48;
    --paper-line:#28405e;
    --grid-guide:#2c465f;
    --cell-fill:#132236;
    --ink:#eef4f6;
    --ink-dim:#8fa6bd;
    --accent:#e8a33d;
    --accent2:#e2603f;
    --radius:10px;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color: transparent;}
  html,body{
    margin:0; padding:0; height:100%;
    background:var(--bg);
    color:var(--ink);
    font-family:'Space Grotesk', system-ui, sans-serif;
    overscroll-behavior:none;
  }
  #app{
    height:100dvh;
    display:flex;
    flex-direction:column;
    background:
      radial-gradient(circle at 1px 1px, #1e3350 1px, transparent 1px) 0 0/16px 16px,
      var(--bg);
  }

  /* ---------- Topbar ---------- */
  #topbar{
    background:var(--paper);
    border-bottom:1px solid var(--paper-line);
    padding:10px 12px 8px;
    flex-shrink:0;
  }
  .row1{
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:8px;
  }
  .brand{
    font-family:'Space Grotesk', sans-serif;
    font-weight:700;
    font-size:15px;
    letter-spacing:1.5px;
    color:var(--ink);
  }
  .brand-accent{ color:var(--accent); }
  .iconbtn{
    background:transparent;
    border:1px solid var(--paper-line);
    color:var(--ink);
    width:34px; height:34px;
    border-radius:8px;
    font-size:18px;
    line-height:1;
    display:flex; align-items:center; justify-content:center;
  }
  .row2{
    display:flex; gap:6px; align-items:center; flex-wrap:wrap;
  }
  .row2 label{
    font-size:11px; color:var(--ink-dim);
    display:flex; flex-direction:column; gap:2px;
  }
  select, input[type=number], input[type=text], textarea{
    background:var(--paper2);
    border:1px solid var(--paper-line);
    color:var(--ink);
    border-radius:7px;
    padding:6px 7px;
    font-family:'IBM Plex Mono', monospace;
    font-size:13px;
    width:100%;
  }
  select{ font-family:'Space Grotesk',sans-serif; }
  #rowsInput,#colsInput{ width:52px; }
  #newGridBtn{
    margin-left:auto;
    background:var(--accent);
    color:#231404;
    border:none;
    border-radius:7px;
    padding:8px 12px;
    font-family:'Space Grotesk',sans-serif;
    font-weight:600;
    font-size:12.5px;
    white-space:nowrap;
    align-self:flex-end;
  }

  /* ---------- Canvas ---------- */
  #canvasWrap{
    flex:1;
    overflow:auto;
    touch-action:none; /* panning is driven manually (two-finger); prevents native scroll from fighting single-finger drawing */
    position:relative;
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding:14px;
  }
  #board{
    width:100%;
    max-width:640px;
    touch-action:none; /* panning is handled manually with two fingers; one finger always draws/taps */
    display:block;
  }
  #zoomControls{
    position:absolute;
    top:10px; right:10px;
    display:flex; flex-direction:column; gap:6px;
    z-index:5;
  }
  #zoomControls button{
    width:30px; height:30px;
    border-radius:8px;
    border:1px solid var(--paper-line);
    background:var(--paper);
    color:var(--ink);
    font-size:16px;
  }

  #hint{
    flex-shrink:0;
    text-align:center;
    font-size:12px;
    color:var(--ink-dim);
    padding:7px 14px;
    background:var(--paper);
    border-top:1px solid var(--paper-line);
  }

  /* ---------- Toolbar ---------- */
  #toolbar{
    flex-shrink:0;
    display:flex;
    background:var(--paper);
    border-top:1px solid var(--paper-line);
    padding:6px 4px calc(6px + env(safe-area-inset-bottom));
    gap:2px;
  }
  .tool{
    flex:1;
    background:transparent;
    border:none;
    color:var(--ink-dim);
    display:flex; flex-direction:column; align-items:center; gap:2px;
    padding:7px 2px;
    border-radius:9px;
  }
  .tool .ti{ font-size:18px; font-family:'IBM Plex Mono',monospace; line-height:1; }
  .tool .tl{ font-size:9.5px; letter-spacing:.3px; }
  .tool.active{ color:var(--accent); background:rgba(232,163,61,0.12); }

  /* ---------- SVG element styles ---------- */
  .cellpoly{ fill:var(--cell-fill); stroke:var(--paper-line); stroke-width:1; }
  .guide{ stroke:var(--grid-guide); stroke-width:1.4; stroke-dasharray:3 5; }
  .edgeline.single{ stroke:var(--ink); stroke-width:5.5; stroke-linecap:round; }
  .edgeline.double{ stroke:var(--accent2); stroke-width:3.6; stroke-linecap:round; }
  .drawline{ stroke:var(--accent); stroke-width:3.4; stroke-linecap:round; opacity:0.95; }
  .previewline{ stroke:var(--accent2); stroke-width:3; stroke-linecap:round; stroke-dasharray:6 5; pointer-events:none; }
  .cellnum{ fill:var(--ink); font-family:'IBM Plex Mono',monospace; font-weight:700; font-size:24px; text-anchor:middle; dominant-baseline:central; }
  .outsidebg{ fill:var(--paper2); stroke:var(--accent); stroke-width:2; }
  .outsidenum{ fill:var(--ink); font-family:'IBM Plex Mono',monospace; font-weight:600; font-size:17px; text-anchor:middle; dominant-baseline:central; }
  .nodedot{ pointer-events:none; }
  .nodedot.cornernode{ fill:var(--accent); opacity:.4; }
  .nodedot.centernode{ fill:var(--ink-dim); opacity:.5; }
  .nodedot.pending{ fill:var(--accent2); opacity:1; }

  /* ---------- Overlays ---------- */
  .overlay{
    position:fixed; inset:0;
    background:rgba(8,14,22,0.55);
    display:flex; align-items:flex-end;
    z-index:20;
  }
  .overlay.hidden{ display:none; }
  .sheet{
    background:var(--paper);
    border-top:1px solid var(--paper-line);
    border-radius:16px 16px 0 0;
    width:100%;
    max-height:88vh;
    overflow:auto;
    padding:16px 16px calc(16px + env(safe-area-inset-bottom));
    max-width:640px;
    margin:0 auto;
  }
  .sheet-title{
    font-weight:600; font-size:14px; letter-spacing:.4px;
    color:var(--ink-dim); text-transform:uppercase;
    margin-bottom:10px;
  }
  .numpad-display{
    font-family:'IBM Plex Mono',monospace;
    font-size:34px; font-weight:700;
    text-align:center;
    background:var(--paper2);
    border:1px solid var(--paper-line);
    border-radius:10px;
    padding:10px;
    margin-bottom:12px;
    min-height:54px;
    letter-spacing:2px;
  }
  .numpad-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:8px;
    margin-bottom:14px;
  }
  .numpad-grid button{
    background:var(--paper2);
    border:1px solid var(--paper-line);
    color:var(--ink);
    font-family:'IBM Plex Mono',monospace;
    font-size:20px;
    border-radius:9px;
    padding:14px 0;
  }
  #npClear, #npBack{ color:var(--accent2); font-size:16px; }
  .sheet-actions{ display:flex; gap:8px; }
  .sheet-actions button{
    flex:1;
    padding:12px;
    border-radius:9px;
    border:1px solid var(--paper-line);
    font-family:'Space Grotesk',sans-serif;
    font-weight:600;
    font-size:13.5px;
  }
  .ghost{ background:transparent; color:var(--ink); }
  .ghost.danger{ color:var(--accent2); border-color:rgba(226,96,63,0.4); }
  .primary{ background:var(--accent); color:#231404; border-color:var(--accent); }
  .ghost.small{ padding:9px 6px; font-size:12px; flex:1; }

  .panel-row{ display:flex; gap:8px; margin-bottom:12px; }
  .panel-row input{ flex:1; }
  .puzzle-list{ max-height:26vh; overflow:auto; margin-bottom:14px; }
  .puzzle-row{
    display:flex; align-items:center; justify-content:space-between;
    padding:9px 4px; border-bottom:1px solid var(--paper-line);
  }
  .puzzle-name{ font-size:13.5px; font-weight:600; }
  .puzzle-sub{ font-size:11px; color:var(--ink-dim); text-transform:capitalize; }
  .puzzle-actions{ display:flex; gap:6px; }
  .puzzle-actions button.small{ padding:6px 10px; font-size:12px; flex:none; }
  .muted{ color:var(--ink-dim); font-size:12.5px; padding:8px 2px; }
  #saveStatus{ min-height:15px; font-size:12px; margin:2px 2px 10px; }
  #ioText{ height:70px; resize:vertical; font-size:11px; margin-bottom:8px; }
  .divider{ border:none; border-top:1px solid var(--paper-line); margin:14px 0; }
</style>
</head>
<body>
<div id="app">

  <header id="topbar">
    <div class="row1">
      <div class="brand">GRID<span class="brand-accent">/</span>SANDBOX</div>
      <button id="menuBtn" class="iconbtn" title="Save / Load">&#8942;</button>
    </div>
    <div class="row2">
      <label>Shape
        <select id="shapeSelect">
          <option value="square">Square</option>
          <option value="triangle">Triangle</option>
          <option value="hex">Hexagon</option>
        </select>
      </label>
      <label>Rows
        <input id="rowsInput" type="number" min="1" max="14" value="5">
      </label>
      <label>Cols
        <input id="colsInput" type="number" min="1" max="14" value="5">
      </label>
      <button id="newGridBtn">New grid</button>
    </div>
  </header>

  <div id="canvasWrap">
    <div id="zoomControls">
      <button id="zoomIn">+</button>
      <button id="zoomOut">&minus;</button>
    </div>
    <svg id="board" xmlns="http://www.w3.org/2000/svg"></svg>
  </div>

  <div id="hint"></div>

  <footer id="toolbar">
    <button class="tool active" data-tool="number"><span class="ti">#</span><span class="tl">Number</span></button>
    <button class="tool" data-tool="outside"><span class="ti">&#9678;</span><span class="tl">Outside</span></button>
    <button class="tool" data-tool="edge"><span class="ti">&#9552;</span><span class="tl">Edge</span></button>
    <button class="tool" data-tool="draw"><span class="ti">&#10530;</span><span class="tl">Draw</span></button>
    <button class="tool" data-tool="erase"><span class="ti">&#10006;</span><span class="tl">Erase</span></button>
    <button class="tool" id="undoBtn"><span class="ti">&#8634;</span><span class="tl">Undo</span></button>
  </footer>

  <!-- Numpad overlay -->
  <div id="numpad" class="overlay hidden">
    <div class="sheet">
      <div class="sheet-title" id="numpadTitle">Enter number</div>
      <div class="numpad-display" id="numpadDisplay">&nbsp;</div>
      <div class="numpad-grid">
        <button data-d="1">1</button><button data-d="2">2</button><button data-d="3">3</button>
        <button data-d="4">4</button><button data-d="5">5</button><button data-d="6">6</button>
        <button data-d="7">7</button><button data-d="8">8</button><button data-d="9">9</button>
        <button id="npBack">&#9003;</button><button data-d="0">0</button><button id="npClear">C</button>
      </div>
      <div class="sheet-actions">
        <button id="npCancel" class="ghost">Cancel</button>
        <button id="npDone" class="primary">Done</button>
      </div>
    </div>
  </div>

  <!-- Save/Load panel -->
  <div id="panel" class="overlay hidden">
    <div class="sheet">
      <div class="sheet-title">Save your puzzle</div>
      <textarea id="ioText" placeholder="Puzzle JSON appears here — or paste JSON here to load it"></textarea>
      <div class="panel-row" style="margin-bottom:6px;">
        <button id="exportBtn" class="ghost small">Copy current puzzle</button>
        <button id="downloadBtn" class="ghost small">Download .json</button>
      </div>
      <div class="panel-row" style="margin-bottom:6px;">
        <button id="importBtn" class="ghost small" style="flex:1;">Load pasted JSON</button>
      </div>
      <div id="saveStatus" class="muted"></div>
      <button id="clearAllBtn" class="ghost danger" style="width:100%; margin-top:6px;">Clear board</button>

      <hr class="divider">
      <div class="sheet-title" id="deviceSaveTitle">Save on this device</div>
      <div class="panel-row">
        <input id="saveName" type="text" placeholder="Name this puzzle">
        <button id="saveBtn" class="primary" style="flex:0 0 auto;">Save</button>
      </div>
      <div id="deviceStatus" class="muted"></div>
      <div id="puzzleList" class="puzzle-list"></div>

      <div class="sheet-actions">
        <button id="panelClose" class="primary">Close</button>
      </div>
    </div>
  </div>

</div>

<script>
(function(){
  "use strict";
  const svgNS = "http://www.w3.org/2000/svg";
  const MARGIN = 68;
  const EDGE_THRESH = 15;
  const NODE_THRESH = 17;
  const LINE_ERASE_THRESH = 10;
  const DRAG_THRESHOLD = 9;

  const boardSvg = document.getElementById('board');
  const hintEl = document.getElementById('hint');
  const shapeSelect = document.getElementById('shapeSelect');
  const rowsInput = document.getElementById('rowsInput');
  const colsInput = document.getElementById('colsInput');
  const newGridBtn = document.getElementById('newGridBtn');
  const menuBtn = document.getElementById('menuBtn');
  const panelEl = document.getElementById('panel');
  const panelClose = document.getElementById('panelClose');
  const saveNameInput = document.getElementById('saveName');
  const saveBtn = document.getElementById('saveBtn');
  const saveStatus = document.getElementById('saveStatus');
  const deviceStatus = document.getElementById('deviceStatus');
  const puzzleListEl = document.getElementById('puzzleList');
  const clearAllBtn = document.getElementById('clearAllBtn');
  const ioText = document.getElementById('ioText');
  const exportBtn = document.getElementById('exportBtn');
  const downloadBtn = document.getElementById('downloadBtn');
  const importBtn = document.getElementById('importBtn');
  const numpadEl = document.getElementById('numpad');
  const numpadTitle = document.getElementById('numpadTitle');
  const numpadDisplay = document.getElementById('numpadDisplay');
  const npCancel = document.getElementById('npCancel');
  const npDone = document.getElementById('npDone');
  const npBack = document.getElementById('npBack');
  const npClear = document.getElementById('npClear');
  const undoBtn = document.getElementById('undoBtn');
  const zoomInBtn = document.getElementById('zoomIn');
  const zoomOutBtn = document.getElementById('zoomOut');

  const PAN_HINT = ' Use two fingers to pan.';
  const HINTS = {
    number: 'Tap a cell to set its number. Tap it again to edit or clear.' + PAN_HINT,
    outside: 'Tap anywhere near the grid to place a free-floating clue number.' + PAN_HINT,
    edge: 'Tap a grid line to cycle: plain \u2192 single line \u2192 double line.' + PAN_HINT,
    draw: 'Drag through corners and cell centers to draw a connected line \u2014 keep your finger down to chain segments. Or tap, then tap again for a single one.' + PAN_HINT,
    erase: 'Tap any number, line, or edge to remove it.' + PAN_HINT
  };

  let P = null;        // puzzle document
  let mesh = null;      // generated geometry
  let cellById = new Map();
  let allNodes = [];    // corners + cell centers, for the Draw tool
  let nodeIndex = new Map();
  let currentTool = 'number';
  let history = [];
  let outsideIdCounter = 1;
  let zoomLevel = 1;

  // numpad state
  let pendingTarget = null;
  let npValue = '';

  // draw-tool state
  let pendingDrawNode = null;   // node id awaiting a second tap
  let previewLineEl = null;
  let dragChainNodeId = null;   // last node in the live drag chain

  // pointer gesture state
  let downPt = null;
  let downNode = null;
  let isDragging = false;

  // multi-touch state (two-finger pan vs single-finger tool gesture)
  let activePointers = new Map();
  let mode = 'idle'; // 'idle' | 'gesture' | 'pan'
  let panLast = null;
  const canvasWrap = document.getElementById('canvasWrap');

  function clamp(v,min,max){ return Math.max(min, Math.min(max, v)); }
  function el(tag, attrs, text){
    const e = document.createElementNS(svgNS, tag);
    for(const k in attrs) e.setAttribute(k, attrs[k]);
    if(text !== undefined) e.textContent = text;
    return e;
  }

  // ---------- Mesh generation ----------
  function assembleMesh(rawCells){
    const vertices = new Map();
    const cells = [];
    let minX=Infinity,minY=Infinity,maxX=-Infinity,maxY=-Infinity;
    function vid(x,y){
      const id = Math.round(x*2) + '_' + Math.round(y*2);
      if(!vertices.has(id)) vertices.set(id, {x, y});
      minX=Math.min(minX,x); minY=Math.min(minY,y);
      maxX=Math.max(maxX,x); maxY=Math.max(maxY,y);
      return id;
    }
    for(const rc of rawCells){
      const verts = rc.pts.map(p => vid(p.x, p.y));
      const cx = rc.pts.reduce((s,p)=>s+p.x,0)/rc.pts.length;
      const cy = rc.pts.reduce((s,p)=>s+p.y,0)/rc.pts.length;
      cells.push({ id: rc.id, verts, poly: rc.pts, center: {x:cx, y:cy} });
    }
    const edges = new Map();
    for(const c of cells){
      for(let i=0;i<c.verts.length;i++){
        const a=c.verts[i], b=c.verts[(i+1)%c.verts.length];
        const key = a<b ? a+'|'+b : b+'|'+a;
        if(!edges.has(key)) edges.set(key, {a,b,cells:[]});
        edges.get(key).cells.push(c.id);
      }
    }
    return { vertices, cells, edges, bbox:{minX,minY,maxX,maxY} };
  }

  function squareCells(rows, cols){
    const s = 62;
    const out = [];
    for(let r=0;r<rows;r++){
      for(let c=0;c<cols;c++){
        out.push({ id:`c_${r}_${c}`, pts:[
          {x:c*s, y:r*s}, {x:(c+1)*s, y:r*s},
          {x:(c+1)*s, y:(r+1)*s}, {x:c*s, y:(r+1)*s}
        ]});
      }
    }
    return out;
  }

  function triangleCells(rows, cols){
    const s = 66;
    const h = s*Math.sqrt(3)/2;
    const pos = (r,c) => ({x: c*s + r*s/2, y: r*h});
    const out = [];
    for(let r=0;r<rows;r++){
      for(let c=0;c<cols;c++){
        const p00=pos(r,c), p01=pos(r,c+1), p10=pos(r+1,c), p11=pos(r+1,c+1);
        out.push({ id:`c_u_${r}_${c}`, pts:[p00,p01,p10] });
        out.push({ id:`c_d_${r}_${c}`, pts:[p01,p11,p10] });
      }
    }
    return out;
  }

  function hexCells(rows, cols){
    const s = 44;
    const wHoriz = Math.sqrt(3)*s;
    const rowH = 1.5*s;
    const out = [];
    for(let r=0;r<rows;r++){
      for(let c=0;c<cols;c++){
        const cx = c*wHoriz + (r%2 ? wHoriz/2 : 0) + wHoriz/2;
        const cy = r*rowH + s;
        const pts = [];
        for(let i=0;i<6;i++){
          const ang = Math.PI/180*(60*i-30);
          pts.push({x: cx + s*Math.cos(ang), y: cy + s*Math.sin(ang)});
        }
        out.push({ id:`c_${r}_${c}`, pts });
      }
    }
    return out;
  }

  function buildMesh(shape, rows, cols){
    let raw;
    if(shape==='triangle') raw = triangleCells(rows, cols);
    else if(shape==='hex') raw = hexCells(rows, cols);
    else raw = squareCells(rows, cols);
    return assembleMesh(raw);
  }

  function rebuildMesh(){
    mesh = buildMesh(P.shape, P.rows, P.cols);
    cellById = new Map(mesh.cells.map(c=>[c.id,c]));
    allNodes = [];
    for(const [vid,v] of mesh.vertices) allNodes.push({id:vid, x:v.x, y:v.y, kind:'corner'});
    for(const c of mesh.cells) allNodes.push({id:'ctr_'+c.id, x:c.center.x, y:c.center.y, kind:'center'});
    nodeIndex = new Map(allNodes.map(n=>[n.id,n]));
  }

  function nodeCoord(id){
    const n = nodeIndex.get(id);
    return n ? {x:n.x, y:n.y} : null;
  }

  // ---------- Geometry helpers ----------
  function pointInPoly(pt, poly){
    let inside=false;
    for(let i=0,j=poly.length-1;i<poly.length;j=i++){
      const xi=poly[i].x, yi=poly[i].y, xj=poly[j].x, yj=poly[j].y;
      const intersect = ((yi>pt.y)!==(yj>pt.y)) && (pt.x < (xj-xi)*(pt.y-yi)/((yj-yi)||1e-9)+xi);
      if(intersect) inside=!inside;
    }
    return inside;
  }
  function findCellAt(pt){
    for(const c of mesh.cells){ if(pointInPoly(pt, c.poly)) return c; }
    return null;
  }
  function distToSeg(p,a,b){
    const dx=b.x-a.x, dy=b.y-a.y;
    const len2 = dx*dx+dy*dy;
    let t = len2 ? ((p.x-a.x)*dx+(p.y-a.y)*dy)/len2 : 0;
    t = Math.max(0, Math.min(1,t));
    const cx=a.x+t*dx, cy=a.y+t*dy;
    return Math.hypot(p.x-cx, p.y-cy);
  }
  function findNearestEdge(pt, thresh){
    let best=null, bestD=thresh;
    for(const [key,e] of mesh.edges){
      const A=mesh.vertices.get(e.a), B=mesh.vertices.get(e.b);
      const d = distToSeg(pt,A,B);
      if(d<bestD){ bestD=d; best={key,e,A,B}; }
    }
    return best;
  }
  function findNearestNode(pt, thresh){
    let best=null, bestD=thresh;
    for(const n of allNodes){
      const d = Math.hypot(pt.x-n.x, pt.y-n.y);
      if(d<bestD){ bestD=d; best=n; }
    }
    return best;
  }
  function toSvgPoint(evt){
    const pt = boardSvg.createSVGPoint();
    pt.x = evt.clientX; pt.y = evt.clientY;
    const ctm = boardSvg.getScreenCTM();
    if(!ctm) return {x:0,y:0};
    const loc = pt.matrixTransform(ctm.inverse());
    return {x:loc.x, y:loc.y};
  }

  // ---------- History ----------
  function pushHistory(){
    history.push(JSON.stringify(P));
    if(history.length>40) history.shift();
  }
  function undo(){
    if(!history.length) return;
    P = JSON.parse(history.pop());
    rebuildMesh();
    syncTopbarFromP();
    render();
  }

  // ---------- Rendering ----------
  function render(){
    boardSvg.innerHTML = '';
    const {minX,minY,maxX,maxY} = mesh.bbox;
    boardSvg.setAttribute('viewBox', `${minX-MARGIN} ${minY-MARGIN} ${(maxX-minX)+MARGIN*2} ${(maxY-minY)+MARGIN*2}`);

    const gCells = el('g',{});
    const gGuides = el('g',{});
    const gLines = el('g',{});
    const gDraw = el('g',{});
    const gNumbers = el('g',{});
    const gOutside = el('g',{});
    const gNodes = el('g',{});

    for(const c of mesh.cells){
      const d = 'M'+c.poly.map(p=>`${p.x},${p.y}`).join('L')+'Z';
      gCells.appendChild(el('path',{d, class:'cellpoly'}));
    }

    for(const [key,e] of mesh.edges){
      const A = mesh.vertices.get(e.a), B = mesh.vertices.get(e.b);
      const val = P.edges[key] || 0;
      if(val===0){
        gGuides.appendChild(el('line',{x1:A.x,y1:A.y,x2:B.x,y2:B.y,class:'guide'}));
      } else if(val===1){
        gLines.appendChild(el('line',{x1:A.x,y1:A.y,x2:B.x,y2:B.y,class:'edgeline single'}));
      } else {
        const dx=B.x-A.x, dy=B.y-A.y, len=Math.hypot(dx,dy)||1;
        const nx=-dy/len, ny=dx/len, off=3.4;
        gLines.appendChild(el('line',{x1:A.x+nx*off,y1:A.y+ny*off,x2:B.x+nx*off,y2:B.y+ny*off,class:'edgeline double'}));
        gLines.appendChild(el('line',{x1:A.x-nx*off,y1:A.y-ny*off,x2:B.x-nx*off,y2:B.y-ny*off,class:'edgeline double'}));
      }
    }

    for(const line of P.lines){
      const A = nodeCoord(line.a), B = nodeCoord(line.b);
      if(A && B) gDraw.appendChild(el('line',{x1:A.x,y1:A.y,x2:B.x,y2:B.y,class:'drawline'}));
    }

    for(const c of mesh.cells){
      const val = P.cellNumbers[c.id];
      if(val !== undefined && val !== ''){
        gNumbers.appendChild(el('text',{x:c.center.x,y:c.center.y,class:'cellnum'}, val));
      }
    }

    for(const o of P.outside){
      gOutside.appendChild(el('circle',{cx:o.x,cy:o.y,r:15,class:'outsidebg'}));
      gOutside.appendChild(el('text',{x:o.x,y:o.y,class:'outsidenum'}, o.value));
    }

    if(currentTool==='draw'){
      for(const n of allNodes){
        const isPending = n.id===pendingDrawNode;
        const cls = 'nodedot ' + (n.kind==='center' ? 'centernode' : 'cornernode') + (isPending ? ' pending' : '');
        gNodes.appendChild(el('circle',{cx:n.x,cy:n.y,r:isPending?8:5,class:cls}));
      }
    }

    boardSvg.append(gCells,gGuides,gLines,gDraw,gNumbers,gOutside,gNodes);
  }

  // ---------- Numpad ----------
  function openNumpad(target){
    pendingTarget = target;
    npValue = (target.initial !== undefined && target.initial !== null) ? String(target.initial) : '';
    numpadTitle.textContent = target.type==='cell' ? 'Cell number' : 'Outside number';
    updateNumpadDisplay();
    numpadEl.classList.remove('hidden');
  }
  function closeNumpad(){
    numpadEl.classList.add('hidden');
    pendingTarget = null;
  }
  function updateNumpadDisplay(){
    numpadDisplay.textContent = npValue === '' ? '\u00A0' : npValue;
  }
  numpadEl.querySelectorAll('button[data-d]').forEach(b=>{
    b.addEventListener('click', ()=>{
      if(npValue.length>=3) return;
      npValue += b.dataset.d;
      updateNumpadDisplay();
    });
  });
  npBack.addEventListener('click', ()=>{ npValue = npValue.slice(0,-1); updateNumpadDisplay(); });
  npClear.addEventListener('click', ()=>{ npValue=''; updateNumpadDisplay(); });
  npCancel.addEventListener('click', closeNumpad);
  npDone.addEventListener('click', ()=>{
    if(!pendingTarget){ closeNumpad(); return; }
    pushHistory();
    if(pendingTarget.type==='cell'){
      if(npValue==='') delete P.cellNumbers[pendingTarget.cellId];
      else P.cellNumbers[pendingTarget.cellId] = npValue;
    } else if(pendingTarget.type==='outside'){
      if(npValue===''){
        if(pendingTarget.id!==null){
          const idx = P.outside.findIndex(o=>o.id===pendingTarget.id);
          if(idx>=0) P.outside.splice(idx,1);
        }
      } else {
        if(pendingTarget.id!==null){
          const o = P.outside.find(o=>o.id===pendingTarget.id);
          if(o) o.value = npValue;
        } else {
          P.outside.push({ id: outsideIdCounter++, x: pendingTarget.x, y: pendingTarget.y, value: npValue });
        }
      }
    }
    closeNumpad();
    render();
  });

  // ---------- Draw tool helpers ----------
  function updatePreviewLine(startNode, pt){
    if(!previewLineEl){
      previewLineEl = el('line', {class:'previewline'});
      boardSvg.appendChild(previewLineEl);
    }
    previewLineEl.setAttribute('x1', startNode.x);
    previewLineEl.setAttribute('y1', startNode.y);
    previewLineEl.setAttribute('x2', pt.x);
    previewLineEl.setAttribute('y2', pt.y);
  }
  function clearPreviewLine(){
    if(previewLineEl){ previewLineEl.remove(); previewLineEl=null; }
  }
  // Deliberate two-tap: flips a segment on/off.
  function commitLine(a, b){
    pushHistory();
    const pair = [a,b].sort();
    const idx = P.lines.findIndex(l => l.a===pair[0] && l.b===pair[1]);
    if(idx>=0) P.lines.splice(idx,1); else P.lines.push({a:pair[0], b:pair[1]});
    render();
  }
  // Fluid drag: only ever adds, so swiping back over your own path never erases it.
  // Appends directly to the live SVG so a mid-drag chain doesn't need a full re-render.
  function addLineIfMissing(a, b){
    const pair = [a,b].sort();
    const exists = P.lines.some(l => l.a===pair[0] && l.b===pair[1]);
    if(exists) return;
    pushHistory();
    P.lines.push({a:pair[0], b:pair[1]});
    const A = nodeCoord(pair[0]), B = nodeCoord(pair[1]);
    if(A && B) boardSvg.appendChild(el('line',{x1:A.x,y1:A.y,x2:B.x,y2:B.y,class:'drawline'}));
  }
  function handleDrawRelease(pt, wasDragging){
    if(wasDragging){
      const endNode = findNearestNode(pt, NODE_THRESH);
      if(endNode && dragChainNodeId && endNode.id !== dragChainNodeId){
        addLineIfMissing(dragChainNodeId, endNode.id);
      }
      pendingDrawNode = null;
      dragChainNodeId = null;
      render();
    } else {
      const tapped = downNode || findNearestNode(pt, NODE_THRESH);
      dragChainNodeId = null;
      if(!tapped){ pendingDrawNode = null; render(); return; }
      if(pendingDrawNode===null){ pendingDrawNode = tapped.id; render(); return; }
      if(pendingDrawNode===tapped.id){ pendingDrawNode = null; render(); return; }
      commitLine(pendingDrawNode, tapped.id);
      pendingDrawNode = null;
    }
  }

  // ---------- Tap handling (non-draw tools) ----------
  function handleTap(tool, pt){
    if(tool==='number'){
      const cell = findCellAt(pt);
      if(!cell) return;
      openNumpad({ type:'cell', cellId: cell.id, initial: P.cellNumbers[cell.id] });
      return;
    }
    if(tool==='outside'){
      const oi = P.outside.findIndex(o=>Math.hypot(pt.x-o.x, pt.y-o.y) < NODE_THRESH);
      if(oi>=0){
        const o = P.outside[oi];
        openNumpad({ type:'outside', id:o.id, x:o.x, y:o.y, initial:o.value });
      } else {
        openNumpad({ type:'outside', id:null, x:pt.x, y:pt.y, initial:undefined });
      }
      return;
    }
    if(tool==='edge'){
      const eh = findNearestEdge(pt, EDGE_THRESH);
      if(!eh) return;
      pushHistory();
      const cur = P.edges[eh.key] || 0;
      const next = (cur+1) % 3;
      if(next===0) delete P.edges[eh.key]; else P.edges[eh.key] = next;
      render();
      return;
    }
    if(tool==='erase'){
      const oi = P.outside.findIndex(o=>Math.hypot(pt.x-o.x, pt.y-o.y) < NODE_THRESH);
      if(oi>=0){ pushHistory(); P.outside.splice(oi,1); render(); return; }

      let bestLine=-1, bestD=LINE_ERASE_THRESH;
      P.lines.forEach((line, idx)=>{
        const A=nodeCoord(line.a), B=nodeCoord(line.b);
        if(!A||!B) return;
        const d = distToSeg(pt,A,B);
        if(d<bestD){ bestD=d; bestLine=idx; }
      });
      if(bestLine>=0){ pushHistory(); P.lines.splice(bestLine,1); render(); return; }

      const eh = findNearestEdge(pt, EDGE_THRESH);
      if(eh && P.edges[eh.key]){ pushHistory(); delete P.edges[eh.key]; render(); return; }

      const cell = findCellAt(pt);
      if(cell && P.cellNumbers[cell.id]!==undefined){ pushHistory(); delete P.cellNumbers[cell.id]; render(); return; }
      return;
    }
  }

  // ---------- Pointer gesture wiring ----------
  // Single finger always drives the active tool (draw / tap); panning is a
  // deliberate two-finger gesture so it never fights with line drawing.
  function avgPoint(pts){
    let x=0,y=0;
    pts.forEach(p=>{ x+=p.x; y+=p.y; });
    return { x:x/pts.length, y:y/pts.length };
  }

  boardSvg.addEventListener('pointerdown', (evt)=>{
    activePointers.set(evt.pointerId, {x:evt.clientX, y:evt.clientY});
    try{ boardSvg.setPointerCapture(evt.pointerId); }catch(e){}

    if(activePointers.size>=2){
      if(mode==='gesture'){
        clearPreviewLine();
        dragChainNodeId=null; downPt=null; downNode=null; isDragging=false;
        render();
      }
      mode = 'pan';
      panLast = avgPoint(Array.from(activePointers.values()));
      return;
    }

    if(mode==='pan') return;

    mode = 'gesture';
    const pt = toSvgPoint(evt);
    downPt = pt;
    isDragging = false;
    if(currentTool==='draw'){
      downNode = findNearestNode(pt, NODE_THRESH);
      dragChainNodeId = downNode ? downNode.id : null;
    } else {
      downNode = null;
    }
  });

  boardSvg.addEventListener('pointermove', (evt)=>{
    if(activePointers.has(evt.pointerId)) activePointers.set(evt.pointerId, {x:evt.clientX, y:evt.clientY});

    if(mode==='pan'){
      const vals = Array.from(activePointers.values());
      if(vals.length<2) return;
      const mid = avgPoint(vals);
      canvasWrap.scrollLeft -= (mid.x - panLast.x);
      canvasWrap.scrollTop -= (mid.y - panLast.y);
      panLast = mid;
      return;
    }

    if(mode!=='gesture' || downPt===null) return;
    const pt = toSvgPoint(evt);
    const moved = Math.hypot(pt.x-downPt.x, pt.y-downPt.y);
    if(moved>DRAG_THRESHOLD) isDragging = true;

    if(currentTool==='draw' && downNode){
      if(isDragging){
        const near = findNearestNode(pt, NODE_THRESH);
        if(near && near.id!==dragChainNodeId){
          addLineIfMissing(dragChainNodeId, near.id);
          dragChainNodeId = near.id;
        }
      }
      const tip = nodeIndex.get(dragChainNodeId) || downNode;
      updatePreviewLine(tip, pt);
    }
  });

  function releasePointer(evt, cancelled){
    activePointers.delete(evt.pointerId);

    if(mode==='pan'){
      if(activePointers.size<2) mode='idle';
      return;
    }
    if(mode!=='gesture') return;
    mode = 'idle';
    if(downPt===null) return;

    const pt = toSvgPoint(evt);
    const wasDragging = isDragging;
    clearPreviewLine();
    if(!cancelled){
      if(currentTool==='draw') handleDrawRelease(pt, wasDragging);
      else if(!wasDragging) handleTap(currentTool, pt);
    } else {
      dragChainNodeId = null;
      render();
    }
    downPt=null; downNode=null; isDragging=false;
  }
  window.addEventListener('pointerup', (evt)=>releasePointer(evt, false));
  boardSvg.addEventListener('pointercancel', (evt)=>releasePointer(evt, true));

  // ---------- Toolbar ----------
  document.querySelectorAll('.tool[data-tool]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      currentTool = btn.dataset.tool;
      pendingDrawNode = null;
      document.querySelectorAll('.tool[data-tool]').forEach(b=>b.classList.toggle('active', b===btn));
      hintEl.textContent = HINTS[currentTool] || '';
      render();
    });
  });
  undoBtn.addEventListener('click', undo);

  // ---------- New grid ----------
  function hasContent(doc){
    return Object.keys(doc.cellNumbers).length>0 || Object.keys(doc.edges).length>0 ||
           doc.lines.length>0 || doc.outside.length>0;
  }
  function freshDoc(shape, rows, cols){
    return { shape, rows, cols, cellNumbers:{}, edges:{}, lines:[], outside:[] };
  }
  newGridBtn.addEventListener('click', ()=>{
    if(hasContent(P) && !confirm('Start a new grid? This clears the current board (save first if you want to keep it).')) return;
    P = freshDoc(shapeSelect.value, clamp(+rowsInput.value||5,1,14), clamp(+colsInput.value||5,1,14));
    history = [];
    pendingDrawNode = null;
    rebuildMesh();
    render();
  });

  function syncTopbarFromP(){
    shapeSelect.value = P.shape;
    rowsInput.value = P.rows;
    colsInput.value = P.cols;
  }

  // ---------- Zoom ----------
  function applyZoom(){ boardSvg.style.width = (zoomLevel*100)+'%'; }
  zoomInBtn.addEventListener('click', ()=>{ zoomLevel = Math.min(2.6, zoomLevel+0.2); applyZoom(); });
  zoomOutBtn.addEventListener('click', ()=>{ zoomLevel = Math.max(0.5, zoomLevel-0.2); applyZoom(); });

  // ---------- Loading / migrating a document ----------
  function migrateAndLoadDoc(d){
    if(!Array.isArray(d.lines)){
      const migrated = [];
      if(d.chords){
        for(const cid in d.chords){
          for(const pair of d.chords[cid]) migrated.push({a:pair[0], b:pair[1]});
        }
      }
      d.lines = migrated;
    }
    P = Object.assign(freshDoc(d.shape||'square', d.rows||5, d.cols||5), d);
    delete P.chords;
    let maxId = 0;
    P.outside.forEach(o=>{ if(o.id>maxId) maxId=o.id; });
    outsideIdCounter = maxId+1;
    history = [];
    pendingDrawNode = null;
    rebuildMesh();
    syncTopbarFromP();
    render();
  }

  function setStatus(msg, ok){
    saveStatus.textContent = msg;
    saveStatus.style.color = ok ? 'var(--accent)' : 'var(--accent2)';
  }
  function setDeviceStatus(msg, ok){
    deviceStatus.textContent = msg;
    deviceStatus.style.color = ok ? 'var(--accent)' : 'var(--accent2)';
  }

  // ---------- Save / Load panel ----------
  menuBtn.addEventListener('click', ()=>{
    panelEl.classList.remove('hidden');
    setStatus('',true);
    setDeviceStatus('',true);
    ioText.value = JSON.stringify(P); // always ready to copy, independent of on-device save working
    refreshPuzzleList();
  });
  panelClose.addEventListener('click', ()=>{ panelEl.classList.add('hidden'); });
  clearAllBtn.addEventListener('click', ()=>{
    if(!hasContent(P)) return;
    if(!confirm('Clear all numbers, lines and edges from the current grid?')) return;
    pushHistory();
    P.cellNumbers={}; P.edges={}; P.lines=[]; P.outside=[];
    render();
  });

  const LS_PREFIX = 'gridsandbox:puzzle:';

  function downloadJSON(filename, data){
    const blob = new Blob([data], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(()=>URL.revokeObjectURL(url), 4000);
  }

  saveBtn.addEventListener('click', ()=>{
    const name = saveNameInput.value.trim();
    if(!name) return;
    const json = JSON.stringify(P);
    ioText.value = json; // ready to copy either way
    try{
      localStorage.setItem(LS_PREFIX+name, json);
      saveNameInput.value='';
      setDeviceStatus('Saved \u201c'+name+'\u201d.', true);
      refreshPuzzleList();
    }catch(e){
      console.error('save failed', e);
      setDeviceStatus('Could not save on this device (storage may be full or blocked). Use "Copy current puzzle" above instead.', false);
    }
  });

  exportBtn.addEventListener('click', async ()=>{
    const json = JSON.stringify(P);
    ioText.value = json;
    try{
      await navigator.clipboard.writeText(json);
      setStatus('Copied to clipboard.', true);
    }catch(e){
      ioText.focus(); ioText.select();
      setStatus('Puzzle JSON is in the box above \u2014 copy it manually.', true);
    }
  });

  downloadBtn.addEventListener('click', ()=>{
    const json = JSON.stringify(P);
    ioText.value = json;
    const base = (saveNameInput.value.trim() || `${P.shape}-${P.rows}x${P.cols}`).replace(/[^a-z0-9\-_]+/gi,'_');
    downloadJSON(base+'.json', json);
    setStatus('Downloading \u201c'+base+'.json\u201d.', true);
  });

  importBtn.addEventListener('click', ()=>{
    const raw = ioText.value.trim();
    if(!raw) return;
    try{
      const d = JSON.parse(raw);
      migrateAndLoadDoc(d);
      setStatus('Loaded from pasted JSON.', true);
      panelEl.classList.add('hidden');
    }catch(e){
      setStatus('That JSON could not be read.', false);
    }
  });

  function refreshPuzzleList(){
    let keys;
    try{
      keys = Object.keys(localStorage).filter(k=>k.startsWith(LS_PREFIX));
    }catch(e){
      puzzleListEl.innerHTML = '<div class="muted">Could not read saved puzzles on this device.</div>';
      return;
    }
    if(!keys.length){ puzzleListEl.innerHTML = '<div class="muted">No saved puzzles yet.</div>'; return; }
    puzzleListEl.innerHTML = '';
    keys.forEach(key=>{
      let d = null;
      try{ d = JSON.parse(localStorage.getItem(key)); }catch(e){}
      const name = key.slice(LS_PREFIX.length);
      const row = document.createElement('div');
      row.className = 'puzzle-row';
      const meta = document.createElement('div');
      const nameEl = document.createElement('div');
      nameEl.className = 'puzzle-name';
      nameEl.textContent = name;
      const subEl = document.createElement('div');
      subEl.className = 'puzzle-sub';
      subEl.textContent = d ? `${d.shape} \u00b7 ${d.rows}\u00d7${d.cols}` : '?';
      meta.appendChild(nameEl); meta.appendChild(subEl);
      const actions = document.createElement('div');
      actions.className = 'puzzle-actions';
      const loadBtn = document.createElement('button');
      loadBtn.className = 'ghost small'; loadBtn.textContent = 'Load';
      loadBtn.addEventListener('click', ()=>loadPuzzle(key));
      const delBtn = document.createElement('button');
      delBtn.className = 'ghost small danger'; delBtn.textContent = '\u2715';
      delBtn.addEventListener('click', ()=>deletePuzzle(key));
      actions.appendChild(loadBtn); actions.appendChild(delBtn);
      row.appendChild(meta); row.appendChild(actions);
      puzzleListEl.appendChild(row);
    });
  }

  function loadPuzzle(key){
    try{
      const raw = localStorage.getItem(key);
      if(raw===null) return;
      const d = JSON.parse(raw);
      migrateAndLoadDoc(d);
      panelEl.classList.add('hidden');
    }catch(e){
      console.error('load failed', e);
      setDeviceStatus('Could not load that puzzle.', false);
    }
  }

  function deletePuzzle(key){
    if(!confirm('Delete this saved puzzle? This cannot be undone.')) return;
    try{
      localStorage.removeItem(key);
      refreshPuzzleList();
    }catch(e){
      console.error('delete failed', e);
      setDeviceStatus('Could not delete that puzzle.', false);
    }
  }

  // ---------- Init ----------
  P = freshDoc('square', 5, 5);
  rebuildMesh();
  hintEl.textContent = HINTS.number;
  render();
})();
</script>
</body>
</html>